{
  "expo": {
    "name": "NarcCheck AI",
    "slug": "narccheck-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.narcanalyzer.cslz18",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Analyse argument screenshots you select",
        "NSMicrophoneUsageDescription": "Record voice notes of arguments to analyse"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.narcanalyzer.cslz18",
      "permissions": [
        "READ_MEDIA_IMAGES",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Analyse argument screenshots you select"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Record voice notes of arguments to analyse"
        }
      ],
      "@react-native-vector-icons/ionicons",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
